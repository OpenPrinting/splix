/*
 * Use bandwidth alignment algorithm for non-list and custom page sizes.
 * This is more or less exactly how is it implemented in the ULD driver.
 *
 * 100 is a hardcoded margin value (50 * 2), as in the driver.
 */
unsigned long _getBandWidthAlignment(unsigned long bandwidth_align,
                                     unsigned long xresolution,
                                     unsigned long inputwidth) {

    const int hardMarginX = 100;
    int divider = 1;
    if (xresolution == 600) divider = 2;
    if (xresolution == 1200) divider = 4;

    inputwidth = (inputwidth / divider - hardMarginX) * divider;
    int bw_aligned = (inputwidth + bandwidth_align - 1) / bandwidth_align * bandwidth_align / 8;

    return bw_aligned;
}

/*
 * Look up bandwidths in bytes generated by Samsung ULD for 2020 series
 * Samsung M2026 does not work unless it receives _exactly_ the right bandwidths
 * Use the table lookup for the paper sizes hard-coded inside ULD driver,
 * fallback to generic bandwidth alignment code.
 */
unsigned long _get2020BandWidthInB(unsigned char papertype,
                                   unsigned long xresolution,
                                   unsigned long inputwidth) {
    struct Bw {
        unsigned char papertype;
        unsigned long width[2];  //standard and high resolution
    };

    const Bw bw[] = {
        {0,640,1248},	//letter
        {1,640,1248},	//legal
        {2,608,1216},	//a4
        {3,544,1056},	//executive
        {4,800,1600},	//ledger
        {5,864,1728},	//A3
        {6,288,576},	//Env10
        {7,288,544},	//monarch envelope
        {8,480,928},	//c5 envelope
        {9,320,608},	//DL envelope
        {10,736,1472},	//b4
        {11,544,1056},	//b5
        {12,512,992},	//b5 iso envelope
        {14,288,576},	//postcard 4x6
        {16,416,832},	//a5
        {17,288,576},	//a6
        {18,384,736},	//b6
        {23,320,640},	//c6
        {24,640,1248},	//folio
        {25,256,512},	//EnvPersonal
        {26,288,544},	//Env9
        {27,224,416},	//IndexCard
        {28,640,1248},	//Oficio
        {30,416,800},	//Statement
        {34,800,1568},	//8K
        {35,576,1120}	//16K
    };

    for (unsigned int i=0; i<sizeof(bw)/sizeof(bw[0]); i++) {
        if (bw[i].papertype == papertype) {
            if (xresolution == 600) return bw[i].width[0];
            if (xresolution == 1200) return bw[i].width[1];
            break;
        }
    }

    /*
     * If printing on an unusual PageSize not from the list, use bandwidth
     * alignment algorithm.
     */
    unsigned long bw_aligned = _getBandWidthAlignment(256, xresolution, inputwidth);

    if (bw_aligned >= 32)
        return bw_aligned;

    return 0;
}

static bool _isEmptyBand(unsigned char* band, unsigned long size)
{
    unsigned long max, mod;

    max = size / sizeof(unsigned long);
    mod = size % sizeof(unsigned long);

    for (unsigned long i=0; i < max; i++) {
        if (((unsigned long*)band)[i])
            return false;
    }
    for (unsigned long i=0; i < mod; i++)
        if (band[size-i-1])
            return false;
    return true;
}
